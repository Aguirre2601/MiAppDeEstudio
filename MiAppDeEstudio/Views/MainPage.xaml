<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MiAppDeEstudio.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MiAppDeEstudio.Models"
    xmlns:local="using:MiAppDeEstudio.Views"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <local:StringToDateTimeConverter x:Key="StringToDateTimeConverter"/>

        <!-- Colores pastel para diseño amistoso -->
        <SolidColorBrush x:Key="ColorFondo" Color="#FFF8F0"/>
        <SolidColorBrush x:Key="ColorTarjeta" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ColorAcento" Color="#FF6B9AFF"/>
        <SolidColorBrush x:Key="ColorAcentoClaro" Color="#FFE3F0FF"/>
        <SolidColorBrush x:Key="ColorTexto" Color="#FF2D3748"/>
        <SolidColorBrush x:Key="ColorTextoSecundario" Color="#FF718096"/>
        <SolidColorBrush x:Key="ColorExito" Color="#FF48BB78"/>
        <SolidColorBrush x:Key="ColorError" Color="#FFF56565"/>

        <!-- Estilo para las tarjetas -->
        <Style x:Key="TarjetaEstilo" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ColorTarjeta}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Estilo para los campos de texto -->
        <Style x:Key="CampoEstilo" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Estilo para el botón principal -->
        <Style x:Key="BotonPrincipalEstilo" TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{StaticResource ColorAcento}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource ColorFondo}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" MaxWidth="600" HorizontalAlignment="Center">

                <!-- Título -->
                <TextBlock Text="📚 Mi App de Estudio" 
                           FontSize="32" FontWeight="Bold" 
                           Foreground="{StaticResource ColorTexto}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <!-- Tarjeta de racha -->
                <Border Style="{StaticResource TarjetaEstilo}" 
                        Background="{StaticResource ColorAcentoClaro}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔥" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentStreak}" 
                                   FontSize="48" FontWeight="Bold" 
                                   Foreground="{StaticResource ColorAcento}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="días de racha" 
                                   FontSize="16" 
                                   Foreground="{StaticResource ColorTextoSecundario}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta del formulario -->
                <Border Style="{StaticResource TarjetaEstilo}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="✏️ Nueva sesión" 
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource ColorTexto}"/>

                        <!-- Fecha -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="📅 Fecha" 
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource ColorTextoSecundario}"/>
                            <TextBox Text="{Binding SelectedDateString, Mode=TwoWay}"
                                     PlaceholderText="yyyy-MM-dd"
                                     Style="{StaticResource CampoEstilo}"/>
                        </StackPanel>

                        <!-- Tema -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="📖 Tema" 
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource ColorTextoSecundario}"/>
                            <TextBox Text="{Binding Topic, Mode=TwoWay}"
                                     PlaceholderText="¿Qué estudiaste hoy?"
                                     Style="{StaticResource CampoEstilo}"/>
                        </StackPanel>

                        <!-- Minutos -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="⏱️ Minutos" 
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource ColorTextoSecundario}"/>
                            <TextBox Text="{Binding MinutesText, Mode=TwoWay}"
                                     PlaceholderText="¿Cuántos minutos?"
                                     Style="{StaticResource CampoEstilo}"
                                     InputScope="Number"/>
                        </StackPanel>

                        <!-- Mensaje de error -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource ColorError}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasError}"/>

                        <!-- Botón guardar -->
                        <Button Content="💾 Guardar sesión"
                                Style="{StaticResource BotonPrincipalEstilo}"
                                Command="{Binding SaveSessionCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta de historial -->
                <Border Style="{StaticResource TarjetaEstilo}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="📋 Historial de sesiones" 
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource ColorTexto}"/>

                        <!-- Lista de sesiones -->
                        <ItemsControl ItemsSource="{Binding Sessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Session">
                                    <Grid Padding="12,8" 
                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                          CornerRadius="8"
                                          Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Topic}" 
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ColorTexto}"/>
                                            <TextBlock Text="{Binding Date}" 
                                                       FontSize="13"
                                                       Foreground="{StaticResource ColorTextoSecundario}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Minutes}" 
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource ColorAcento}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Mensaje cuando no hay sesiones -->
                        <TextBlock Text="¡Aún no hay sesiones! ¡Empieza hoy! 🌟"
                                   FontSize="14"
                                   Foreground="{StaticResource ColorTextoSecundario}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16"
                                   Visibility="{Binding Sessions.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
